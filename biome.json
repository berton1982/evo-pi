{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/globals.css",
      "!**/coverage",
      "!**/build",
      "!**/.my-idea",
      "!**/ref_projects"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "warn",
        "useNodejsImportProtocol": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "**/lib/fixtures/**"
                ],
                "message": "生产代码不得 import 桩数据（fixtures）。桩只在 PR.A/PR.B 期间存在，PR.D 集成后必须退役。确实需要固定夹具时，请放到同目录的 __fixtures__/ 或测试文件旁。"
              },
              {
                "group": [
                  "@evo-pi/core/adapters/**",
                  "@evo-pi/core/infrastructure/**"
                ],
                "message": "web 层不得直接 import core 的 adapters / infrastructure（ADR 0003 import 规则）。请经由 core/domain/ports/ 与 HTTP 边界。"
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noUndeclaredEnvVars": {
          "level": "error",
          "options": {
            "allowedEnvVars": [
              "CI",
              "PLAYWRIGHT_.*",
              "EVO_PI_.*",
              "PI_CODING_AGENT_DIR",
              "HOME",
              "USERPROFILE"
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.test.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/web/src/shell/layout/resize-handle.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/web/src/shell/layout/top-bar.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    }
  ]
}
