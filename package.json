{
  "name": "evo-pi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "evo-pi monorepo — workflow engine on top of pi ecosystem",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "wiki:check": "node tooling/check-wiki-diagrams.mjs",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "version-packages": "changeset version",
    "check:boundaries": "node packages/web/scripts/check-boundaries.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "biome check --write --no-errors-on-unmatched",
    "*.{json,jsonc}": "biome format --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "turbo": "^2.11.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "bash-language-server": "^5.8.1",
    "typescript-language-server": "^6.0.2",
    "yaml-language-server": "^2.0.0"
  }
}
