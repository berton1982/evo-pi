{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AGENT_FAKE_DELAY_MS",
    "CI",
    "PLAYWRIGHT_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {},
    "test": {
      "outputs": [
        "coverage/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
